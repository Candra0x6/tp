{
  "name": "trust-fall-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @trust-fall/web dev",
    "dev:backend": "pnpm --filter @trust-fall/backend dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "turbo": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@solana/web3.js": "1.98.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
